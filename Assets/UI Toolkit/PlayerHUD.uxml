<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="PlayerHUD.uss" />
    <Style src="PlayerHeatHUD.uss" />
    <ui:VisualElement name="player-hud" picking-mode="Ignore">
        <ui:VisualElement name="lock-on-marker" class="lock-on-marker" picking-mode="Ignore" />
        <ui:VisualElement name="human-health-bar" class="human-health-bar">
            <ui:Label name="human-health-title" text="VIDA" class="human-health-title" />
            <ui:VisualElement name="human-health-track" class="human-health-track">
                <ui:VisualElement name="human-health-fill" class="human-health-fill" />
            </ui:VisualElement>
            <ui:Label name="human-health-value" text="100 / 100" class="human-health-value" />
        </ui:VisualElement>
        <ui:VisualElement name="heat-thermometer">
            <ui:VisualElement name="thermometer-heading">
                <ui:Label name="thermometer-title" text="TERMÔMETRO" />
                <ui:Label name="heat-power-value" text="1x" />
            </ui:VisualElement>
            <ui:VisualElement name="thermometer-main-row">
                <ui:VisualElement name="thermometer-cold-notches" class="thermometer-notch-group" />
                <ui:VisualElement name="thermometer-zero-notch" />
                <ui:VisualElement name="thermometer-hot-notches" class="thermometer-notch-group" />
            </ui:VisualElement>
            <ui:VisualElement name="thermometer-superheat-notches" class="thermometer-notch-group thermometer-superheat-row" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
