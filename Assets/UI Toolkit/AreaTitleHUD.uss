.area-title-card {
    position: absolute;
    right: 64px;
    bottom: 56px;
    width: 560px;
    align-items: flex-end;
    opacity: 0;
}

.area-title-name {
    width: 100%;
    color: rgb(255, 255, 255);
    font-size: 38px;
    white-space: normal;
    -unity-text-align: lower-right;
}

.area-title-divider {
    width: 100%;
    height: 2px;
    margin-top: 5px;
    margin-bottom: 5px;
    background-color: rgba(255, 255, 255, 0.8);
}

.area-title-subtitle {
    width: 100%;
    color: rgba(255, 255, 255, 0.8);
    font-size: 22px;
    unity-font-style: italic;
    white-space: normal;
    -unity-text-align: upper-right;
}
