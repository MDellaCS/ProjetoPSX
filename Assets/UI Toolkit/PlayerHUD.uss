#player-hud {
    position: absolute;
    left: 32px;
    bottom: 32px;
    width: 420px;
    padding: 12px;
    background-color: rgba(8, 10, 14, 0.82);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(205, 212, 225);
    border-top-color: rgb(205, 212, 225);
    border-right-color: rgb(205, 212, 225);
    border-bottom-color: rgb(205, 212, 225);
}

#heat-header {
    flex-direction: row;
    justify-content: space-between;
}

#heat-value,
#heat-power-value,
#superheat-value,
#dash-text {
    color: rgb(235, 238, 244);
    font-size: 14px;
    margin-bottom: 4px;
}

#heat-power-value {
    color: rgb(255, 210, 92);
}

#heat-notch-row {
    height: 16px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.notch-group {
    flex-direction: row;
}

.heat-notch,
.superheat-notch {
    width: 12px;
    height: 16px;
    margin-right: 2px;
    background-color: rgb(34, 39, 49);
}

#heat-zero-notch {
    width: 4px;
    height: 16px;
    margin-left: 3px;
    margin-right: 5px;
    background-color: rgb(245, 245, 245);
}

.superheat-notch-group {
    margin-left: 12px;
}

#dash-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

#dash-indicator {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    background-color: rgb(230, 245, 255);
}

#combat-controls-hint {
    color: rgb(167, 184, 195);
    font-size: 12px;
    margin-top: 5px;
    white-space: normal;
}
