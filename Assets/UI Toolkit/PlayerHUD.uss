:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

#player-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
}

.lock-on-marker {
    position: absolute;
    display: none;
    width: 16px;
    height: 16px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(80, 255, 100);
    border-right-color: rgb(80, 255, 100);
    border-bottom-color: rgb(80, 255, 100);
    border-left-color: rgb(80, 255, 100);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.human-health-bar {
    position: absolute;
    left: 28px;
    bottom: 30px;
    width: 320px;
    padding: 10px;
    background-color: rgba(8, 10, 14, 0.78);
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(220, 225, 232, 0.6);
    border-top-color: rgba(220, 225, 232, 0.6);
    border-right-color: rgba(220, 225, 232, 0.6);
    border-bottom-color: rgba(220, 225, 232, 0.6);
}

.human-health-title {
    margin-bottom: 5px;
    color: rgb(235, 235, 235);
    font-size: 12px;
    -unity-font-style: bold;
}

.human-health-track {
    height: 12px;
    background-color: rgb(35, 35, 39);
}

.human-health-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(190, 38, 44);
}

.human-health-value {
    margin-top: 5px;
    color: rgb(235, 235, 235);
    font-size: 11px;
    -unity-text-align: middle-right;
}
