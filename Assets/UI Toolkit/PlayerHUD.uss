#player-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
}

.human-health-bar {
    position: absolute;
    left: 28px;
    bottom: 30px;
    width: 320px;
    padding: 10px;
    background-color: rgba(8, 10, 14, 0.78);
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(220, 225, 232, 0.6);
    border-top-color: rgba(220, 225, 232, 0.6);
    border-right-color: rgba(220, 225, 232, 0.6);
    border-bottom-color: rgba(220, 225, 232, 0.6);
}

.human-health-title {
    margin-bottom: 5px;
    color: rgb(235, 235, 235);
    font-size: 12px;
    -unity-font-style: bold;
}

.human-health-track {
    height: 12px;
    background-color: rgb(35, 35, 39);
}

.human-health-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(190, 38, 44);
}

.human-health-value {
    margin-top: 5px;
    color: rgb(235, 235, 235);
    font-size: 11px;
    -unity-text-align: middle-right;
}
