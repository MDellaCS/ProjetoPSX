:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

#player-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
}

.human-health-bar {
    position: absolute;
    left: 28px;
    bottom: 30px;
    width: 320px;
    padding: 10px;
    background-color: rgba(8, 10, 14, 0.78);
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(220, 225, 232, 0.6);
    border-top-color: rgba(220, 225, 232, 0.6);
    border-right-color: rgba(220, 225, 232, 0.6);
    border-bottom-color: rgba(220, 225, 232, 0.6);
}

.human-health-title {
    margin-bottom: 5px;
    color: rgb(235, 235, 235);
    font-size: 12px;
    -unity-font-style: bold;
}

.human-health-track {
    height: 12px;
    background-color: rgb(35, 35, 39);
}

.human-health-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(190, 38, 44);
}

.human-health-loss {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background-color: rgba(190, 38, 44, 0.45);
}

.human-health-value {
    margin-top: 5px;
    color: rgb(235, 235, 235);
    font-size: 11px;
    -unity-text-align: middle-right;
}

.vital-oil-bar { position: absolute; left: 28px; top: 28px; width: 320px; }
.vital-oil-track {
    height: 20px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(210, 210, 210);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    overflow: hidden;
}
.vital-oil-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
    background-color: rgb(5, 5, 5);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}
.vital-oil-loss {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background-color: rgba(5, 5, 5, 0.45);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}
