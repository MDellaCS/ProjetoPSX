<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/DialogueHUD.uss?fileID=7433441132597879392&amp;guid=6e5d2741eb0242e78f5fedddfbca3a6c&amp;type=3#DialogueHUD"/>
    <ui:VisualElement name="dialogue-root" class="dialogue-root" picking-mode="Ignore">
        <ui:VisualElement name="dialogue-fade" class="dialogue-fade"/>
        <ui:VisualElement name="dialogue-text-block" class="dialogue-text-block">
            <ui:Label name="dialogue-speaker" class="dialogue-speaker"/>
            <ui:Label name="dialogue-message" text="Dialogue message" class="dialogue-message"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
