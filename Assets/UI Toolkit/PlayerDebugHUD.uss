:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

#debug-panel {
    position: absolute;
    left: 16px;
    top: 16px;
    min-width: 250px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.78);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(120, 180, 255);
    border-top-color: rgb(120, 180, 255);
    border-right-color: rgb(120, 180, 255);
    border-bottom-color: rgb(120, 180, 255);
}

#water-state-label {
    position: absolute;
    display: none;
    width: 150px;
    height: 42px;
    padding-top: 2px;
    background-color: rgba(225, 241, 255, 0.88);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    color: rgb(15, 43, 75);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#debug-text {
    color: rgb(225, 240, 255);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
}

#debug-menu-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 680px;
    max-height: 90%;
    padding: 20px;
    translate: -50% -50%;
    display: none;
    background-color: rgb(22, 27, 32);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(83, 255, 150);
    border-top-color: rgb(83, 255, 150);
    border-right-color: rgb(83, 255, 150);
    border-bottom-color: rgb(83, 255, 150);
}

.debug-menu-title {
    color: rgb(110, 255, 165);
    font-size: 32px;
    -unity-font-style: bold;
}

.debug-menu-hint, .debug-menu-status {
    color: rgb(185, 205, 190);
    font-size: 19px;
    margin-bottom: 12px;
}

.debug-menu-status {
    margin-top: 8px;
    white-space: normal;
}

.debug-menu-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.debug-menu-row Button {
    min-height: 44px;
    margin-right: 8px;
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 18px;
    color: rgb(230, 240, 232);
    background-color: rgb(48, 61, 54);
    border-left-color: rgb(102, 141, 113);
    border-top-color: rgb(102, 141, 113);
    border-right-color: rgb(102, 141, 113);
    border-bottom-color: rgb(102, 141, 113);
}

.debug-menu-row Button:hover {
    background-color: rgb(66, 92, 74);
}

.debug-menu-row Button.debug-danger {
    color: white;
    background-color: rgb(132, 47, 47);
}

#currency-input {
    min-width: 240px;
    min-height: 42px;
    margin-right: 6px;
    color: rgb(240, 240, 240);
    font-size: 18px;
}

#currency-input .unity-base-field__label {
    color: rgb(210, 220, 215);
    font-size: 18px;
}

#test-shortcuts-panel {
    position: absolute;
    right: 16px;
    top: 16px;
    min-width: 250px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.78);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 215, 120);
    border-top-color: rgb(255, 215, 120);
    border-right-color: rgb(255, 215, 120);
    border-bottom-color: rgb(255, 215, 120);
}

#test-shortcuts-text {
    color: rgb(255, 240, 200);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
}

#cutscene-debug-panel {
    position: absolute;
    right: 16px;
    bottom: 16px;
    min-width: 300px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.78);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 195, 75);
    border-top-color: rgb(255, 195, 75);
    border-right-color: rgb(255, 195, 75);
    border-bottom-color: rgb(255, 195, 75);
}

#cutscene-debug-text {
    color: rgb(255, 235, 190);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
}

#cutscene-timeline-bar {
    height: 10px;
    margin-top: 8px;
    background-color: rgb(55, 45, 25);
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 215, 120);
    border-top-color: rgb(255, 215, 120);
    border-right-color: rgb(255, 215, 120);
    border-bottom-color: rgb(255, 215, 120);
}

#cutscene-timeline-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(255, 180, 45);
}

.debug-submenu {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    width: 500px; height: 70%; padding: 20px; display: none;
    background-color: rgb(22, 27, 32);
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgb(83, 255, 150); border-right-color: rgb(83, 255, 150);
    border-top-color: rgb(83, 255, 150); border-bottom-color: rgb(83, 255, 150);
}
#debug-submenu-list { flex-grow: 1; }
#debug-submenu-list Button, #debug-submenu-list Toggle { min-height: 36px; font-size: 18px; color: rgb(230, 240, 232); }

#debug-submenu-list Button {
    min-height: 44px;
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(48, 61, 54);
    border-left-color: rgb(102, 141, 113);
    border-top-color: rgb(102, 141, 113);
    border-right-color: rgb(102, 141, 113);
    border-bottom-color: rgb(102, 141, 113);
}

#debug-submenu-list Button:hover {
    background-color: rgb(66, 92, 74);
}

.debug-level-row { flex-direction: row; align-items: center; margin-bottom: 6px; }
.debug-level-name { flex-grow: 1; color: rgb(230, 240, 232); font-size: 20px; }
.debug-level-value { min-width: 80px; color: rgb(230, 240, 232); font-size: 18px; -unity-text-align: middle-center; }
.debug-level-row Button { min-width: 48px; }

.lockon-debug-panel {
    position: absolute;
    top: 16px;
    width: 154px;
    padding: 6px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.78);
    display: none;
}
.lockon-debug-left { left: 16px; }
.lockon-debug-right { right: 16px; }
#debug-panel.lockon-debug-shifted { left: 178px; }
.lockon-debug-title { color: rgb(225, 240, 255); font-size: 16px; -unity-text-align: middle-center; }
.lockon-debug-text { color: rgb(225, 240, 255); font-size: 14px; white-space: normal; -unity-text-align: middle-center; }
.lockon-debug-pad {
    position: relative;
    width: 96px;
    height: 96px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(180, 200, 220);
    border-right-color: rgb(180, 200, 220);
    border-top-color: rgb(180, 200, 220);
    border-bottom-color: rgb(180, 200, 220);
    border-top-left-radius: 48px;
    border-top-right-radius: 48px;
    border-bottom-left-radius: 48px;
    border-bottom-right-radius: 48px;
}
.lockon-debug-axis-x { position: absolute; left: 0; top: 46px; width: 94px; height: 1px; background-color: rgba(180, 200, 220, 0.5); }
.lockon-debug-axis-y { position: absolute; left: 46px; top: 0; width: 1px; height: 94px; background-color: rgba(180, 200, 220, 0.5); }
.lockon-debug-diagonal { position: absolute; width: 4px; height: 4px; background-color: rgba(180, 200, 220, 0.7); }
.lockon-debug-nw { left: 13px; top: 13px; }
.lockon-debug-ne { left: 77px; top: 13px; }
.lockon-debug-sw { left: 13px; top: 77px; }
.lockon-debug-se { left: 77px; top: 77px; }
.lockon-debug-deadzone {
    position: absolute;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 130, 100);
    border-right-color: rgb(255, 130, 100);
    border-top-color: rgb(255, 130, 100);
    border-bottom-color: rgb(255, 130, 100);
    border-top-left-radius: 48px;
    border-top-right-radius: 48px;
    border-bottom-left-radius: 48px;
    border-bottom-right-radius: 48px;
}
.lockon-debug-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgb(255, 220, 90);
}

.debug-submenu.debug-gizmo-submenu { width: 80%; max-width: 900px; height: 85%; }
#debug-gizmo-list { flex-grow: 1; display: none; }
.debug-gizmo-group { margin-bottom: 12px; padding-left: 10px; padding-right: 10px; }
.debug-gizmo-heading { color: rgb(130, 220, 160); font-size: 20px; -unity-font-style: bold; margin-top: 8px; margin-bottom: 4px; }
#debug-gizmo-list Toggle { min-height: 34px; font-size: 18px; color: rgb(230, 240, 232); }

.debug-dps-panel { position: absolute; right: 16px; bottom: 16px; width: 340px; padding: 10px; background-color: rgba(0, 0, 0, 0.82); border-left-width: 2px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-color: rgb(120, 180, 255); border-top-color: rgb(120, 180, 255); border-right-color: rgb(120, 180, 255); border-bottom-color: rgb(120, 180, 255); display: none; }
.debug-dps-text { color: rgb(225, 240, 255); font-size: 20px; }
.debug-dps-graph { height: 110px; margin-top: 6px; background-color: rgb(25, 35, 40); }
.debug-dps-range { color: rgb(180, 205, 215); font-size: 15px; }

#debug-time-scale-input { min-width: 180px; margin-right: 8px; color: rgb(230, 240, 232); font-size: 18px; }

#debug-menu-panel .unity-base-field__label {
    color: rgb(210, 220, 215);
}

#debug-menu-panel .unity-base-text-field__input {
    color: rgb(240, 245, 240);
    background-color: rgb(35, 45, 40);
    border-left-color: rgb(102, 141, 113);
    border-top-color: rgb(102, 141, 113);
    border-right-color: rgb(102, 141, 113);
    border-bottom-color: rgb(102, 141, 113);
}

.debug-bpm-panel { position: absolute; left: 50%; bottom: 16px; translate: -50% 0; width: 90%; height: 30%; padding: 10px; background-color: rgba(0, 0, 0, 0.82); border-left-width: 2px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-color: rgb(120, 180, 255); border-top-color: rgb(120, 180, 255); border-right-color: rgb(120, 180, 255); border-bottom-color: rgb(120, 180, 255); display: none; }
.debug-bpm-timeline { flex-grow: 1; background-color: rgb(25, 35, 40); overflow: hidden; }
.debug-bpm-intervals { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.debug-bpm-interval { position: absolute; width: 90px; translate: -50% 0; -unity-text-align: middle-center; color: rgb(255, 225, 130); background-color: rgba(25, 35, 40, 0.9); font-size: 20px; }
#debug-bpm-input { min-width: 180px; margin-right: 8px; color: rgb(230, 240, 232); font-size: 18px; }
