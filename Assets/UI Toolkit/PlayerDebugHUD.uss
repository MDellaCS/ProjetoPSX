:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

#debug-panel {
    position: absolute;
    left: 16px;
    top: 16px;
    min-width: 250px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.78);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(120, 180, 255);
    border-top-color: rgb(120, 180, 255);
    border-right-color: rgb(120, 180, 255);
    border-bottom-color: rgb(120, 180, 255);
}

#water-state-label {
    position: absolute;
    display: none;
    width: 150px;
    height: 42px;
    padding-top: 2px;
    background-color: rgba(225, 241, 255, 0.88);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    color: rgb(15, 43, 75);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#debug-text {
    color: rgb(225, 240, 255);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
}

#debug-menu-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 680px;
    max-height: 90%;
    padding: 20px;
    translate: -50% -50%;
    display: none;
    background-color: rgb(22, 27, 32);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(83, 255, 150);
    border-top-color: rgb(83, 255, 150);
    border-right-color: rgb(83, 255, 150);
    border-bottom-color: rgb(83, 255, 150);
}

.debug-menu-title {
    color: rgb(110, 255, 165);
    font-size: 32px;
    -unity-font-style: bold;
}

.debug-menu-hint, .debug-menu-status {
    color: rgb(185, 205, 190);
    font-size: 19px;
    margin-bottom: 12px;
}

.debug-menu-status {
    margin-top: 8px;
    white-space: normal;
}

.debug-menu-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.debug-menu-row Button {
    min-height: 44px;
    margin-right: 8px;
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 18px;
    color: rgb(230, 240, 232);
    background-color: rgb(48, 61, 54);
    border-left-color: rgb(102, 141, 113);
    border-top-color: rgb(102, 141, 113);
    border-right-color: rgb(102, 141, 113);
    border-bottom-color: rgb(102, 141, 113);
}

.debug-menu-row Button:hover {
    background-color: rgb(66, 92, 74);
}

.debug-menu-row Button.debug-danger {
    color: white;
    background-color: rgb(132, 47, 47);
}

#currency-input {
    min-width: 240px;
    min-height: 42px;
    margin-right: 6px;
    color: rgb(240, 240, 240);
    font-size: 18px;
}

#currency-input .unity-base-field__label {
    color: rgb(210, 220, 215);
    font-size: 18px;
}

#enemy-debug-panel {
    position: absolute;
    right: 16px;
    top: 250px;
    min-width: 250px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.78);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(130, 255, 160);
    border-top-color: rgb(130, 255, 160);
    border-right-color: rgb(130, 255, 160);
    border-bottom-color: rgb(130, 255, 160);
}

#test-shortcuts-panel {
    position: absolute;
    right: 16px;
    top: 16px;
    min-width: 250px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.78);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 215, 120);
    border-top-color: rgb(255, 215, 120);
    border-right-color: rgb(255, 215, 120);
    border-bottom-color: rgb(255, 215, 120);
}

#test-shortcuts-text {
    color: rgb(255, 240, 200);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
}

#enemy-debug-text {
    color: rgb(220, 255, 225);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
}

#cutscene-debug-panel {
    position: absolute;
    right: 16px;
    bottom: 16px;
    min-width: 300px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.78);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 195, 75);
    border-top-color: rgb(255, 195, 75);
    border-right-color: rgb(255, 195, 75);
    border-bottom-color: rgb(255, 195, 75);
}

#cutscene-debug-text {
    color: rgb(255, 235, 190);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
}

#cutscene-timeline-bar {
    height: 10px;
    margin-top: 8px;
    background-color: rgb(55, 45, 25);
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 215, 120);
    border-top-color: rgb(255, 215, 120);
    border-right-color: rgb(255, 215, 120);
    border-bottom-color: rgb(255, 215, 120);
}

#cutscene-timeline-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(255, 180, 45);
}
