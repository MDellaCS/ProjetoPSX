:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

#heat-thermometer {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
}

#heat-multiplier {
    position: absolute;
    right: 15%;
    top: 56%;
    min-width: 100px;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    overflow: visible;
}

#heat-power-value {
    color: rgb(255, 225, 140);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transform-origin: 50% 50%;
}

#thermometer-main-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.thermometer-notch-group {
    flex-direction: row;
    align-items: center;
    overflow: visible;
}

.thermometer-notch {
    position: relative;
    flex-shrink: 0;
    margin-right: 3px;
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(150, 150, 150);
    border-top-color: rgb(150, 150, 150);
    border-right-color: rgb(150, 150, 150);
    border-bottom-color: rgb(150, 150, 150);
    overflow: hidden;
}

.thermometer-notch-fill, .thermometer-notch-loss { position: absolute; left: 0; top: 0; height: 100%; width: 0%; }

.thermometer-notch-heavy-cost {
    border-left-width: 3px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}
