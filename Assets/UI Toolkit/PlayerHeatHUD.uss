:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

#heat-thermometer {
    position: absolute;
    left: 50%;
    margin-left: -220px;
    top: 57%;
    width: 440px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(8, 10, 14, 0.18);
}

#thermometer-heading {
    height: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

#thermometer-title {
    color: rgb(198, 207, 220);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

#heat-power-value {
    min-width: 52px;
    margin-left: 8px;
    color: rgb(255, 225, 140);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transform-origin: 50% 50%;
}

#thermometer-main-row {
    height: 6px;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    overflow: visible;
}

.thermometer-notch-group {
    flex-direction: row;
    align-items: stretch;
    overflow: hidden;
}

.thermometer-notch {
    position: relative;
    flex-shrink: 0;
    width: 10px;
    height: 6px;
    background-color: rgb(28, 32, 39);
    border-right-width: 1px;
    border-right-color: rgba(4, 7, 12, 0.9);
    overflow: hidden;
}

.thermometer-notch-major {
    border-right-width: 3px;
    border-right-color: rgba(190, 196, 204, 0.9);
}

.thermometer-notch-fill {
    height: 100%;
    width: 0%;
}

#thermometer-zero-notch {
    flex-shrink: 0;
    width: 3px;
    height: 8px;
    margin-left: 3px;
    margin-right: 3px;
    margin-top: -1px;
    background-color: rgb(235, 239, 245);
}

.thermometer-superheat-row {
    height: 2px;
    margin-top: 3px;
    justify-content: flex-end;
}

.thermometer-superheat-notch {
    position: relative;
    flex-shrink: 0;
    width: 10px;
    height: 2px;
    margin-left: 1px;
    background-color: rgb(38, 24, 26);
    overflow: hidden;
}

.thermometer-superheat-notch .thermometer-notch-fill {
    height: 100%;
    width: 0%;
}
