:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

#boss-hud {
    position: absolute;
    top: 32px;
    left: 50%;
    width: 620px;
    margin-left: -310px;
    padding: 10px 14px;
    background-color: rgba(10, 8, 12, 0.84);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(190, 56, 65);
    border-top-color: rgb(190, 56, 65);
    border-right-color: rgb(190, 56, 65);
    border-bottom-color: rgb(190, 56, 65);
}

#boss-name {
    color: rgb(255, 225, 225);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

#boss-health-track {
    height: 20px;
    background-color: rgb(46, 25, 31);
}

#boss-health-fill {
    height: 100%;
    background-color: rgb(205, 47, 59);
}

#boss-health-value {
    color: rgb(245, 220, 220);
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-top: 4px;
}
