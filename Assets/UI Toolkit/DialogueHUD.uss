.dialogue-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.dialogue-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
}

.dialogue-message {
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: 4.5%;
    color: #eeeeee;
    font-size: 40px;
    white-space: normal;
    -unity-text-align: middle-center;
}
