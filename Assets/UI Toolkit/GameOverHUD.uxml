<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="GameOverHUD.uss" />
    <ui:VisualElement name="game-over-overlay">
        <ui:VisualElement name="game-over-content">
            <ui:Label name="game-over-title" text="GAME OVER" />
            <ui:Label name="game-over-message" text="VOCE MORREU" />
            <ui:Label name="game-over-retry" text="PRESSIONE R PARA RECOMECAR" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
