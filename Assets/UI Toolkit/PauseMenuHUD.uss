#pause-menu-overlay {
    display: none;
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    bottom: 0px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.72);
}

#pause-menu-content {
    width: 700px;
    max-height: 90%;
    padding: 28px;
    background-color: rgba(15, 17, 24, 0.96);
    border-left-width: 3px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(118, 190, 205);
    border-top-color: rgb(118, 190, 205);
    border-right-color: rgb(118, 190, 205);
    border-bottom-color: rgb(118, 190, 205);
}

#pause-settings-view { display: none; }
#pause-settings-title { color: rgb(225, 245, 250); font-size: 30px; -unity-font-style: bold; margin-bottom: 14px; }
#pause-settings-tabs { flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
#pause-settings-tabs Button { min-width: 118px; margin-right: 6px; font-size: 13px; }
#settings-options { height: 320px; margin-bottom: 12px; }
#settings-options Button { min-height: 42px; height: auto; white-space: normal; }
#settings-status { min-height: 25px; color: rgb(255, 215, 135); font-size: 14px; }
#pause-settings-footer { flex-direction: row; justify-content: space-between; }
#pause-settings-footer Button { min-width: 125px; margin-right: 6px; font-size: 13px; }
#pause-key-hint { color: rgb(150, 175, 185); font-size: 13px; -unity-text-align: middle-center; margin-top: 8px; }
.settings-selected { background-color: rgb(82, 120, 135); }
.settings-option-label { color: rgb(230, 240, 245); font-size: 16px; margin-top: 9px; margin-bottom: 3px; }

#pause-menu-overlay.main-menu-mode {
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0.18);
}

#pause-menu-overlay.main-menu-mode #pause-menu-content {
    width: 500px;
    height: 100%;
    max-height: 100%;
    justify-content: center;
    padding-left: 52px;
    padding-right: 52px;
    background-color: rgba(9, 12, 17, 0.88);
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 2px;
    border-bottom-width: 0;
    border-right-color: rgba(118, 190, 205, 0.7);
}

#pause-menu-overlay.main-menu-mode #pause-menu-title {
    font-size: 46px;
    -unity-text-align: middle-left;
    margin-bottom: 42px;
}

#main-menu-status {
    display: none;
    color: rgb(255, 195, 130);
    font-size: 15px;
    white-space: normal;
    margin-bottom: 14px;
}

#pause-menu-overlay.main-menu-mode #pause-menu-content Button {
    height: 56px;
    margin-bottom: 14px;
    -unity-text-align: middle-left;
    padding-left: 18px;
    background-color: rgba(31, 39, 48, 0.92);
}

#pause-menu-overlay.main-menu-mode #pause-menu-content Button:hover,
#pause-menu-overlay.main-menu-mode #pause-menu-content .settings-selected {
    background-color: rgb(70, 106, 119);
}

#pause-menu-title {
    color: rgb(225, 245, 250);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
}

#pause-menu-content Button {
    height: 42px;
    margin-bottom: 10px;
    color: rgb(235, 240, 242);
    font-size: 17px;
    -unity-font-style: bold;
    background-color: rgb(39, 51, 61);
    border-left-color: rgb(118, 190, 205);
    border-top-color: rgb(118, 190, 205);
    border-right-color: rgb(118, 190, 205);
    border-bottom-color: rgb(118, 190, 205);
}

#pause-menu-content Button:hover {
    background-color: rgb(70, 106, 119);
}
