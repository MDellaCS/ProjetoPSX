/*
 * Menu inicial, pausa e opcoes: UM unico estilo minimalista, alinhado a direita.
 *
 * Como manter:
 *  - Cores, tamanhos e espacamentos ficam nos tokens (--menu-*) logo abaixo.
 *  - Blocos: .menu-overlay > .menu-panel > .menu-view (principal ou opcoes).
 *  - Botao: .menu-button + um modificador de tamanho (--primary, --small ou nenhum).
 *    O Button e a caixa de interacao invisivel; o texto fica no filho .menu-button-label.
 *  - Estado de selecao (teclado, controle e hover do mouse): .is-selected.
 *  - Novas telas reaproveitam estas classes; nao crie estilos por modo (pausa/inicial).
 */

:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");

    --menu-dim: rgba(0, 0, 0, 0.35);
    --menu-text: rgb(255, 255, 255);
    --menu-text-disabled: rgb(110, 110, 110);
    --menu-underline: rgb(255, 255, 255);
    --menu-message: rgb(255, 195, 130);

    --menu-max-width: 560px;
    --menu-pad-top: 320px;
    --menu-pad-bottom: 40px;
    --menu-pad-right: 72px;
    --menu-pad-left: 24px;
    --menu-gap: 20px;

    --menu-font-primary: 38px;
    --menu-font-title: 38px;
    --menu-font-option: 25px;
    --menu-font-small: 21px;
    --menu-font-tab: 20px;
    --menu-font-note: 18px;

    --menu-hit-primary: 68px;
    --menu-hit-option: 50px;
    --menu-hit-small: 46px;
    --menu-options-height: 440px;
    --menu-bars-width: 240px;
    --menu-underline-width: 2px;
}

/* ---------- Estrutura ---------- */

.menu-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: stretch;
    background-color: var(--menu-dim);
}

.menu-panel {
    width: 100%;
    max-width: var(--menu-max-width);
    height: 100%;
    max-height: 100%;
    justify-content: flex-start;
    align-items: stretch;
    padding: var(--menu-pad-top) var(--menu-pad-right) var(--menu-pad-bottom) var(--menu-pad-left);
    transform-origin: right top;
}

.menu-view {
    flex-shrink: 1;
    min-height: 0;
    align-items: stretch;
}

.menu-view--settings { display: none; }
.menu-inventory-view { display: none; }
.inventory-content { flex-direction: row; align-items: center; justify-content: center; flex-grow: 1; min-height: 0; width: 100%; }
.inventory-detail { width: 42%; max-width: 560px; height: 100%; min-width: 0; align-items: center; justify-content: center; padding: 12px 28px; }
.inventory-image { width: 100%; height: 250px; margin-bottom: 14px; }
.inventory-item-name { width: 100%; color: var(--menu-text); font-size: 29px; -unity-text-align: middle-center; margin-bottom: 10px; }
.inventory-description { width: 100%; color: var(--menu-text); font-size: 20px; white-space: normal; -unity-text-align: middle-center; }
.inventory-side-item { width: 22%; max-width: 250px; height: 52%; align-items: center; justify-content: center; opacity: 0.48; }
.inventory-side-image { width: 100%; height: 170px; }
.inventory-side-name { width: 100%; margin-top: 8px; color: var(--menu-text); font-size: 18px; -unity-text-align: middle-center; }
.inventory-arrow { width: 48px; height: 64px; margin: 0 14px; padding: 0; color: var(--menu-text); font-size: 48px; background-color: rgba(0,0,0,0); border-width: 0; }
.inventory-close-hint { align-self: center; margin-top: 16px; color: var(--menu-text-disabled); font-size: 16px; }
.inventory-open { justify-content: center; }
.inventory-open .menu-panel { width: 100%; max-width: 100%; height: 100%; padding: 5vh 5vw; background-color: rgba(0, 0, 0, 0); }
.inventory-open .menu-inventory-view { width: 100%; }

.item-modal {
    display: none;
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.88);
}
.item-modal-panel { width: 62%; max-width: 760px; height: 88%; align-items: center; justify-content: center; }
.item-modal-image { width: 100%; height: 72%; margin-bottom: 22px; }
.item-modal-name { color: white; font-size: 38px; -unity-text-align: middle-center; margin-bottom: 18px; }
.item-modal-close-hint { color: rgba(255,255,255,.8); font-size: 22px; -unity-text-align: middle-center; }

/* ---------- Botao: caixa invisivel (area de interacao) + texto com linha ---------- */

/* Layout e tipografia (um unico lugar). */
Button.menu-button {
    height: auto;
    min-height: var(--menu-hit-option);
    margin: 0 0 6px 0;
    padding: 6px 0;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    color: var(--menu-text);
    font-size: var(--menu-font-option);
    -unity-font-style: normal;
}

/* Todos os estados sem caixa visivel (o tema padrao pinta fundo e borda). */
Button.menu-button,
Button.menu-button:hover,
Button.menu-button:active,
Button.menu-button:focus,
Button.menu-button:disabled {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
}

Button.menu-button--primary { font-size: var(--menu-font-primary); min-height: var(--menu-hit-primary); }
Button.menu-button--small {
    font-size: var(--menu-font-small);
    min-height: var(--menu-hit-small);
    margin-left: var(--menu-gap);
}

Button.menu-button--tab {
    font-size: var(--menu-font-tab);
    min-height: var(--menu-hit-small);
    margin-left: var(--menu-gap);
    flex-shrink: 0;
}

Label.menu-button-label {
    margin: 0;
    padding: 0 0 3px 0;
    color: var(--menu-text);
    white-space: normal;
    -unity-text-align: middle-right;
    border-bottom-width: var(--menu-underline-width);
    border-bottom-color: rgba(255, 255, 255, 0);
}

/* Selecionado (teclado/controle/hover) ou aba ativa: linha sob o texto. */
.menu-button.is-selected Label.menu-button-label,
.menu-button.is-active Label.menu-button-label { border-bottom-color: var(--menu-underline); }

Button.menu-button--tab Label.menu-button-label { white-space: nowrap; }

Button.menu-button:disabled Label.menu-button-label {
    color: var(--menu-text-disabled);
    border-bottom-color: rgba(255, 255, 255, 0);
}

/* ---------- Opcoes ---------- */

.menu-title {
    flex-shrink: 0;
    margin-bottom: 18px;
    color: var(--menu-text);
    font-size: var(--menu-font-title);
    -unity-text-align: middle-right;
}

.menu-tabs {
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
    justify-content: flex-end;
    margin-bottom: 14px;
}

/* Altura fixa (o rodape nao se move entre abas); se nao couber, rola na vertical (barra invisivel). */
.menu-options {
    height: var(--menu-options-height);
    min-height: 0;
    flex-grow: 0;
    flex-shrink: 1;
    margin-bottom: 12px;
}

.menu-option-label {
    margin-top: 10px;
    margin-bottom: 3px;
    color: var(--menu-text);
    font-size: var(--menu-font-small);
    -unity-text-align: middle-right;
}

.menu-step-row {
    flex-direction: row;
    justify-content: flex-end;
}

.menu-status {
    flex-shrink: 0;
    min-height: 25px;
    color: var(--menu-message);
    font-size: var(--menu-font-note);
    -unity-text-align: middle-right;
}

.menu-footer {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: flex-end;
}

/* Slot: o botao original e Sim/Nao ocupam o mesmo lugar (sem layout shift). */
.menu-slot { position: relative; flex-shrink: 0; }

.menu-confirm {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
}

.menu-confirm Button.menu-button { margin-left: 28px; }

/* Controle 0-9: botao inteiro e a area de interacao; 10 barras clicaveis. */
.menu-bars {
    flex-direction: row;
    width: var(--menu-bars-width);
    max-width: 100%;
    height: 40px;
    margin-top: 4px;
    align-items: center;
}

.menu-bar {
    flex-grow: 1;
    height: 20px;
    margin-left: 5px;
    background-color: rgba(255, 255, 255, 0.22);
}

.menu-bar-first { margin-left: 0; }
.menu-bar.is-filled { background-color: var(--menu-text); }

/* Aviso do menu inicial (ex.: cutscene ausente). */
.menu-message {
    display: none;
    color: var(--menu-message);
    font-size: var(--menu-font-note);
    white-space: normal;
    -unity-text-align: middle-right;
    margin-bottom: 14px;
}

/* ---------- Outros HUDs que compartilham este arquivo ---------- */

#currency-shop-overlay .currency-shop-selected {
    background-color: rgba(150, 105, 55, 0.75);
    border-left-width: 2px;
    border-left-color: rgb(235, 190, 115);
}

/* ---------- Escala dos menus (Opcoes > Acessibilidade) ----------
 * O PauseMenuHUD aplica scale + a classe .menu-scale-N (N = nivel 0-9, 0,8x a 1,4x).
 * Quanto maior a escala, menores os espacamentos: visual = base / escala.
 * Valores = token / escala^2 (a escala multiplica de volta). Se mudar os tokens
 * --menu-pad-* ou --menu-gap, recalcule este bloco. */
.menu-scale-0 { --menu-pad-top: 500.0px; --menu-pad-bottom: 62.5px; --menu-pad-right: 112.5px; --menu-pad-left: 37.5px; --menu-gap: 31.2px; }
.menu-scale-1 { --menu-pad-top: 426.0px; --menu-pad-bottom: 53.3px; --menu-pad-right: 95.9px; --menu-pad-left: 32.0px; --menu-gap: 26.6px; }
.menu-scale-2 { --menu-pad-top: 367.3px; --menu-pad-bottom: 45.9px; --menu-pad-right: 82.7px; --menu-pad-left: 27.6px; --menu-gap: 23.0px; }
.menu-scale-3 { --menu-pad-top: 320.0px; --menu-pad-bottom: 40.0px; --menu-pad-right: 72.0px; --menu-pad-left: 24.0px; --menu-gap: 20.0px; }
.menu-scale-4 { --menu-pad-top: 281.2px; --menu-pad-bottom: 35.2px; --menu-pad-right: 63.3px; --menu-pad-left: 21.1px; --menu-gap: 17.6px; }
.menu-scale-5 { --menu-pad-top: 249.1px; --menu-pad-bottom: 31.1px; --menu-pad-right: 56.1px; --menu-pad-left: 18.7px; --menu-gap: 15.6px; }
.menu-scale-6 { --menu-pad-top: 222.2px; --menu-pad-bottom: 27.8px; --menu-pad-right: 50.0px; --menu-pad-left: 16.7px; --menu-gap: 13.9px; }
.menu-scale-7 { --menu-pad-top: 199.4px; --menu-pad-bottom: 24.9px; --menu-pad-right: 44.9px; --menu-pad-left: 15.0px; --menu-gap: 12.5px; }
.menu-scale-8 { --menu-pad-top: 180.0px; --menu-pad-bottom: 22.5px; --menu-pad-right: 40.5px; --menu-pad-left: 13.5px; --menu-gap: 11.2px; }
.menu-scale-9 { --menu-pad-top: 163.3px; --menu-pad-bottom: 20.4px; --menu-pad-right: 36.7px; --menu-pad-left: 12.2px; --menu-gap: 10.2px; }
