<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="PauseMenuHUD.uss" />
    <ui:VisualElement name="pause-menu-overlay" class="menu-overlay">
        <ui:VisualElement name="pause-menu-content" class="menu-panel">
            <ui:VisualElement name="pause-main-view" class="menu-view">
                <ui:Label name="main-menu-status" class="menu-message" text="" />
                <ui:VisualElement class="menu-slot">
                    <ui:Button name="menu-primary-button" class="menu-button menu-button--primary" text="Continuar" />
                    <ui:VisualElement name="menu-primary-confirm" class="menu-confirm">
                        <ui:Button name="menu-primary-yes" class="menu-button menu-button--primary" text="Sim" />
                        <ui:Button name="menu-primary-no" class="menu-button menu-button--primary" text="Não" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="menu-save-button" class="menu-button menu-button--primary" text="Carregar Save" />
                <ui:Button name="menu-options-button" class="menu-button menu-button--primary" text="Opções" />
                <ui:Button name="menu-exit-button" class="menu-button menu-button--primary" text="Sair" />
            </ui:VisualElement>
            <ui:VisualElement name="save-slots-view" class="menu-view menu-view--save-slots">
                <ui:Label name="save-slots-title" class="menu-title" text="CARREGAR JOGO" />
                <ui:Label name="save-slots-status" class="menu-message" text="" />
                <ui:ScrollView name="save-slots-list" class="save-slots-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                    <ui:Button name="save-slot-0" class="menu-button save-slot-button" text="Slot 1 — Vazio" />
                    <ui:Button name="save-slot-1" class="menu-button save-slot-button" text="Slot 2 — Vazio" />
                    <ui:Button name="save-slot-2" class="menu-button save-slot-button" text="Slot 3 — Vazio" />
                    <ui:Button name="save-slot-3" class="menu-button save-slot-button" text="Slot 4 — Vazio" />
                    <ui:Button name="save-slot-4" class="menu-button save-slot-button" text="Slot 5 — Vazio" />
                    <ui:Button name="save-slot-auto" class="menu-button save-slot-button" text="Checkpoint automatico — Vazio" />
                </ui:ScrollView>
                <ui:VisualElement name="sanctuary-save-row" class="menu-slot sanctuary-save-row">
                    <ui:Button name="sanctuary-save-button" class="menu-button menu-button--primary" text="Salvar" />
                </ui:VisualElement>
                <ui:VisualElement name="save-slot-confirm" class="save-slot-confirm">
                    <ui:Label name="save-slot-confirm-message" class="menu-message" text="Confirmar?" />
                    <ui:Button name="save-slot-confirm-yes" class="menu-button menu-button--small" text="Sim" />
                    <ui:Button name="save-slot-confirm-no" class="menu-button menu-button--small" text="Não" />
                </ui:VisualElement>
                <ui:Button name="save-slots-back" class="menu-button menu-button--small" text="Voltar" />
            </ui:VisualElement>
            <ui:VisualElement name="pause-inventory-view" class="menu-view menu-inventory-view">
                <ui:Label name="inventory-title" class="menu-title" text="INVENTÁRIO" />
                <ui:VisualElement class="inventory-content">
                    <ui:Button name="inventory-previous-button" class="inventory-arrow" text="‹" />
                    <ui:VisualElement name="inventory-previous-item" class="inventory-side-item">
                        <ui:Image name="inventory-previous-image" class="inventory-side-image" scale-mode="ScaleToFit" />
                        <ui:Label name="inventory-previous-name" class="inventory-side-name" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="inventory-detail">
                        <ui:Image name="inventory-image" class="inventory-image" scale-mode="ScaleToFit" />
                        <ui:Label name="inventory-item-name" class="inventory-item-name" text="" />
                        <ui:Label name="inventory-description" class="inventory-description" text="Selecione um item-chave." />
                    </ui:VisualElement>
                    <ui:VisualElement name="inventory-next-item" class="inventory-side-item">
                        <ui:Image name="inventory-next-image" class="inventory-side-image" scale-mode="ScaleToFit" />
                        <ui:Label name="inventory-next-name" class="inventory-side-name" text="" />
                    </ui:VisualElement>
                    <ui:Button name="inventory-next-button" class="inventory-arrow" text="›" />
                </ui:VisualElement>
                <ui:Label class="inventory-close-hint" text="I / Esc  Fechar" />
            </ui:VisualElement>
            <ui:VisualElement name="pause-settings-view" class="menu-view menu-view--settings">
                <ui:Label name="pause-settings-title" class="menu-title" text="OPÇÕES" />
                <ui:VisualElement name="pause-settings-tabs" class="menu-tabs">
                    <ui:Button name="settings-audio-tab" class="menu-button menu-button--tab" text="ÁUDIO" />
                    <ui:Button name="settings-video-tab" class="menu-button menu-button--tab" text="VÍDEO" />
                    <ui:Button name="settings-camera-tab" class="menu-button menu-button--tab" text="CÂMERA" />
                    <ui:Button name="settings-controls-tab" class="menu-button menu-button--tab" text="CONTROLES" />
                    <ui:Button name="settings-accessibility-tab" class="menu-button menu-button--tab" text="ACESSIBILIDADE" />
                </ui:VisualElement>
                <ui:ScrollView name="settings-options" class="menu-options" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
                <ui:Label name="settings-status" class="menu-status" text="" />
                <ui:VisualElement name="pause-settings-footer" class="menu-footer">
                    <ui:VisualElement class="menu-slot">
                        <ui:Button name="settings-defaults-button" class="menu-button menu-button--small" text="Restaurar Padrões" />
                        <ui:VisualElement name="settings-defaults-confirm" class="menu-confirm">
                            <ui:Button name="settings-defaults-yes" class="menu-button menu-button--small" text="Sim" />
                            <ui:Button name="settings-defaults-no" class="menu-button menu-button--small" text="Não" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="settings-back-button" class="menu-button menu-button--small" text="Voltar" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="item-acquisition-modal" class="item-modal">
        <ui:VisualElement class="item-modal-panel">
            <ui:Image name="item-modal-image" class="item-modal-image" scale-mode="ScaleToFit" />
            <ui:Label name="item-modal-name" class="item-modal-name" text="" />
            <ui:Label name="item-modal-close-hint" class="item-modal-close-hint" text="[E / Clique] Fechar" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
