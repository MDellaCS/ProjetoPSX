<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="PauseMenuHUD.uss" />
    <ui:VisualElement name="pause-menu-overlay">
        <ui:VisualElement name="pause-menu-content">
            <ui:VisualElement name="pause-main-view">
                <ui:Label name="pause-menu-title" text="PAUSADO" />
                <ui:Label name="main-menu-status" text="" />
                <ui:Button name="pause-resume-button" text="CONTINUAR" />
                <ui:Button name="pause-settings-button" text="CONFIGURAÇÕES" />
                <ui:Button name="pause-quit-button" text="SAIR" />
            </ui:VisualElement>
            <ui:VisualElement name="pause-settings-view">
                <ui:Label name="pause-settings-title" text="CONFIGURAÇÕES" />
                <ui:VisualElement name="pause-settings-tabs">
                    <ui:Button name="settings-audio-tab" text="ÁUDIO" />
                    <ui:Button name="settings-video-tab" text="VÍDEO" />
                    <ui:Button name="settings-camera-tab" text="CÂMERA" />
                    <ui:Button name="settings-controls-tab" text="CONTROLES" />
                    <ui:Button name="settings-accessibility-tab" text="ACESSIBILIDADE" />
                </ui:VisualElement>
                <ui:ScrollView name="settings-options" />
                <ui:Label name="settings-status" text="" />
                <ui:VisualElement name="pause-settings-footer">
                    <ui:Button name="settings-defaults-button" text="PADRÕES DA SEÇÃO" />
                    <ui:Button name="settings-apply-button" text="APLICAR" />
                    <ui:Button name="settings-cancel-button" text="CANCELAR" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="pause-key-hint" text="Q: PAUSAR / VOLTAR" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
