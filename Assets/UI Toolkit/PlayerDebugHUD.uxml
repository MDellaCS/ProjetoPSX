<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="PlayerDebugHUD.uss" />
    <ui:Label name="water-state-label" text="FUNDA" picking-mode="Ignore" />
    <ui:VisualElement name="debug-panel" picking-mode="Ignore">
        <ui:Label name="debug-text" text="DEBUG HUD" />
    </ui:VisualElement>
    <ui:VisualElement name="debug-menu-panel">
        <ui:VisualElement class="debug-menu-row">
            <ui:Button name="status-max-button" text="MAX ALL STATUS" />
            <ui:Button name="status-zero-button" text="ZERO ALL STATUS" />
        </ui:VisualElement>
        <ui:VisualElement name="heat-controls" class="debug-menu-row">
            <ui:Button name="heat-minus-button" text="HEAT -10" />
            <ui:Button name="heat-plus-button" text="HEAT +10" />
        </ui:VisualElement>
        <ui:VisualElement class="debug-menu-row">
            <ui:IntegerField name="currency-input" label="Money" value="0" />
            <ui:Button name="currency-take-button" text="TAKE CURRENCY" />
            <ui:Button name="currency-give-button" text="GIVE CURRENCY" />
        </ui:VisualElement>
        <ui:VisualElement class="debug-menu-row">
            <ui:Button name="god-mode-button" text="GOD MODE: OFF" />
            <ui:Button name="combat-override-button" text="COMBAT OVERRIDE: NEUTRAL" />
            <ui:Button name="slow-motion-button" text="SLOW MOTION: OFF" />
        </ui:VisualElement>
        <ui:VisualElement class="debug-menu-row">
            <ui:Button name="kill-player-button" text="KILL PLAYER" class="debug-danger" />
            <ui:Button name="next-moveset-button" text="NEXT MOVESET" />
            <ui:Button name="select-scene-button" text="SELECT SCENE" />
            <ui:Button name="reload-scene-button" text="RELOAD SCENE" />
        </ui:VisualElement>
        <ui:VisualElement class="debug-menu-row">
            <ui:Button name="environment-previous-button" text="PREVIOUS ENVIRONMENT" />
            <ui:Button name="environment-next-button" text="NEXT ENVIRONMENT" />
        </ui:VisualElement>
        <ui:VisualElement class="debug-menu-row">
            <ui:Button name="reset-save-button" text="RESET GAME SAVE" class="debug-danger" />
            <ui:Button name="clear-key-items-button" text="CLEAR KEY ITEMS" class="debug-danger" />
            <ui:Button name="select-gizmos-button" text="F3 GIZMOS" />
        </ui:VisualElement>
        <ui:Label name="debug-action-status" text="Ready." class="debug-menu-status" />
    </ui:VisualElement>
    <ui:VisualElement name="debug-submenu" class="debug-submenu">
        <ui:Label name="debug-submenu-title" class="debug-menu-title" />
        <ui:ScrollView name="debug-submenu-list" />
        <ui:VisualElement class="debug-menu-row"><ui:Button name="debug-submenu-back" text="BACK" /></ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="enemy-debug-panel" picking-mode="Ignore">
        <ui:Label name="enemy-debug-text" text="ENEMY DEBUG" />
    </ui:VisualElement>
    <ui:VisualElement name="cutscene-debug-panel" picking-mode="Ignore">
        <ui:Label name="cutscene-debug-text" text="CUTSCENE DEBUG" />
        <ui:VisualElement name="cutscene-timeline-bar">
            <ui:VisualElement name="cutscene-timeline-fill" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
