:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

.temporary-world-prompt {
    position: absolute;
    left: 50%;
    bottom: 14%;
    translate: -50% 0;
    min-width: 260px;
    padding: 12px 18px;
    background-color: rgba(8, 10, 14, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(255, 184, 44);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.25);
    border-right-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.25);
}

.temporary-world-prompt__content {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.temporary-world-prompt__keys {
    flex-direction: row;
    align-items: center;
}

.temporary-world-prompt__key-icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.temporary-world-prompt__key-arrow {
    margin-left: 4px;
    margin-right: 4px;
    color: rgb(255, 193, 60);
    font-size: 16px;
    -unity-font-style: bold;
}

.temporary-world-prompt__key-fallback {
    min-width: 28px;
    height: 28px;
    margin-right: 8px;
    padding-left: 6px;
    padding-right: 6px;
    color: rgb(20, 22, 26);
    background-color: rgb(235, 240, 245);
    -unity-text-align: middle-center;
    font-size: 14px;
    -unity-font-style: bold;
}

.temporary-world-prompt__body {
    color: rgb(235, 240, 245);
    font-size: 18px;
    -unity-font-style: bold;
}

.temporary-world-prompt__progress {
    width: 100%;
    height: 4px;
    margin-top: 9px;
    background-color: rgba(255, 255, 255, 0.2);
}

.temporary-world-prompt__progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(255, 184, 44);
}

.temporary-world-prompt__progress {
    width: 100%;
    height: 4px;
    margin-top: 9px;
    background-color: rgba(255, 255, 255, 0.2);
}

.temporary-world-prompt__progress-fill {
    width: 0%;
    height: 100%;
    background-color: rgb(255, 184, 44);
}
