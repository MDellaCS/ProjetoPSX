:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

.loading-screen-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(13, 17, 25);
    opacity: 1;
}

/* Anel com um arco claro; a rotacao e animada pelo LoadingScreenHUD. */
.loading-spinner {
    position: absolute;
    right: 48px;
    bottom: 48px;
    width: 44px;
    height: 44px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: rgb(245, 235, 216);
    border-right-color: rgba(245, 235, 216, .12);
    border-bottom-color: rgba(245, 235, 216, .12);
    border-left-color: rgba(245, 235, 216, .12);
}
