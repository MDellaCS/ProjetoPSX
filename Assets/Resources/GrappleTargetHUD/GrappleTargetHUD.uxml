<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="GrappleTargetHUD.uss" />
    <ui:VisualElement name="grapple-layer" picking-mode="Ignore">
        <ui:VisualElement name="grapple-marker" class="grapple-marker" picking-mode="Ignore">
            <ui:VisualElement name="grapple-glow" class="grapple-glow" picking-mode="Ignore" />
            <ui:VisualElement name="grapple-disc" class="grapple-disc" picking-mode="Ignore">
                <ui:VisualElement name="grapple-core" class="grapple-core" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
