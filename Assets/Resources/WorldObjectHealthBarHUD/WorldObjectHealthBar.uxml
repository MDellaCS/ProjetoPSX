<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="WorldObjectHealthBarHUD.uss" />
    <ui:VisualElement name="world-bar" class="world-bar" picking-mode="Ignore">
        <ui:VisualElement name="world-bar-track" class="world-bar-track" picking-mode="Ignore">
            <ui:VisualElement name="world-bar-fill" class="world-bar-fill" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="world-bar-text" class="world-bar-text" text="" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
