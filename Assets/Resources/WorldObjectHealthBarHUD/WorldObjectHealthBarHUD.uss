:root {
    -unity-font-definition: url("project://database/Assets/Fonts/Crimson%20Text/CrimsonText-Regular.ttf");
}

#world-bar-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.world-bar {
    position: absolute;
    width: 120px;
    margin-left: -60px;
    align-items: stretch;
}

.world-bar-track {
    height: 9px;
    background-color: rgba(18, 10, 12, 0.85);
    border-left-width: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(230, 200, 150);
    border-top-color: rgb(230, 200, 150);
    border-right-color: rgb(230, 200, 150);
    border-bottom-color: rgb(230, 200, 150);
}

.world-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(205, 47, 59);
}

.world-bar-text {
    color: rgb(245, 235, 216);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 1px;
}
